{
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.28.4",
  "scripts": {
    "build": "pnpm -r --filter './packages/**' run build",
    "deps:update": "taze",
    "knip": "knip",
    "knip:production": "knip --production",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "release": "bumpp",
    "test": "pnpm run build && pnpm -r --filter './packages/**' run test",
    "typecheck": "pnpm -r --filter './packages/**' run test:types"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.19.1",
    "bumpp": "^11.1.0",
    "eslint": "^10.12.0",
    "knip": "^6.39.0",
    "taze": "^19.17.2",
    "typescript": "^6.0.3"
  }
}
