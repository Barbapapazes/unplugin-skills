{
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "build": "pnpm -r --filter './packages/**' run build",
    "deps:update": "taze",
    "knip": "knip",
    "knip:production": "knip --production",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "release": "bumpp",
    "test": "pnpm run build && pnpm -r --filter './packages/**' run test",
    "typecheck": "pnpm -r --filter './packages/**' run test:types"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.1.0",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.13.2",
    "bumpp": "^12.3.0",
    "eslint": "^10.5.0",
    "knip": "^6.23.0",
    "taze": "^21.3.0",
    "typescript": "^7.0.2"
  }
}
